# Database
DATABASE_URL=postgresql://localhost/storyagent

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Secret (please change in production)
SECRET_KEY=change-this-to-a-strong-random-string

# LLM Configuration (OpenAI-compatible API)
LLM_BASE_URL=https://your-api-base-url/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=qwen-plus

# Embedding Model (HuggingFace local model)
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5

# RAG Settings
RAG_DATA_DIR=rag_data
FAISS_INDEX_DIR=faiss_index
RAG_TOP_K=5

# Story Settings
MAX_STORY_SCENES=8
MAX_SCENE_LENGTH=500
